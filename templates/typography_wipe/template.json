      1.1
    ],
    "intensity": "medium",
    "avoid_when": [
      "长句字幕",
      "重要画面细节位于字形内部"
    ],
    "selection_prompt": "当素材属于动漫、短剧或实况直播并出现标题、卡点、金句或章节变化时，若文案为1至4个短词且对比清晰，优先使用文字遮罩卡点；效果持续0.35至1.1秒；避免用于长句字幕或字形内有重要细节的画面。"
  },
